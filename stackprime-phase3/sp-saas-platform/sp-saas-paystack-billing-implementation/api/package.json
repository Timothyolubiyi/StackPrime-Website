{
  "name": "sp-saas-platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "db:immutable-audit": "prisma db execute --file prisma/sql/audit_immutable.sql --schema prisma/schema.prisma",
    "seed": "tsx --env-file=.env prisma/seed.ts",
    "make-staff": "tsx --env-file=.env scripts/make-staff.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.650.0",
    "@aws-sdk/s3-request-presigner": "^3.650.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^10.0.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^10.4.0",
    "otpauth": "^9.3.4",
    "prisma": "5.22.0",
    "stripe": "^16.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.0",
    "@types/nodemailer": "^6.4.16",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
