# --- Runtime ---
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# --- Database / cache ---
DATABASE_URL=postgresql://sp:sp@localhost:5432/sp_saas?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth (generate with: openssl rand -base64 48 / openssl rand -base64 32) ---
JWT_SECRET=change-me-at-least-32-characters-long-secret
MFA_ENC_KEY=base64-encoded-32-byte-key-change-me-change-me=

# --- Zoho Mail SMTP ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=support@stackprimeconsulting.com.ng
SMTP_PASS=
MAIL_FROM="StackPrime Support <support@stackprimeconsulting.com.ng>"
ADMIN_NOTIFY_EMAIL=support@stackprimeconsulting.com.ng

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- DigitalOcean Spaces (PRIVATE artifacts bucket) ---
SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
SPACES_REGION=lon1
SPACES_BUCKET=stackprime-saas-artifacts
SPACES_KEY=
SPACES_SECRET=

# Billing: Paystack is the primary gateway. Keep disabled until live/test credentials and prices are configured.
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
# Stripe remains a disabled optional adapter until StackPrime is eligible and configured.
STRIPE_ENABLED=false
