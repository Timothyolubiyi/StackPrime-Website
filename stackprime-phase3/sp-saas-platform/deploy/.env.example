# deploy/.env  (read by docker-compose for substitution). Never commit the real file.
POSTGRES_USER=spsaas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sp_saas
REDIS_PASSWORD=change-me-long-random

DO_REGISTRY_NAMESPACE=change-me   # the SAME namespace as the marketing site
API_TAG=app-prod-0000000

# ---- 1 GB droplet (s-1vcpu-1gb) defaults ----
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=256MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=32MB
PG_MAX_CONNECTIONS=30
PG_MEM_LIMIT=384m
REDIS_MAXMEMORY=128mb
REDIS_MEM_LIMIT=192m
API_HEAP_MB=192
API_MEM_LIMIT=320m

# ---- 2 GB droplet (s-1vcpu-2gb): uncomment to raise caps after resizing ----
# PG_SHARED_BUFFERS=384MB
# PG_EFFECTIVE_CACHE_SIZE=1GB
# PG_WORK_MEM=8MB
# PG_MAINTENANCE_WORK_MEM=64MB
# PG_MAX_CONNECTIONS=60
# PG_MEM_LIMIT=896m
# REDIS_MAXMEMORY=256mb
# REDIS_MEM_LIMIT=320m
# API_HEAP_MB=384
# API_MEM_LIMIT=512m

# ---- backups (used by backup.sh) ----
BACKUP_BUCKET=stackprime-saas-backups
BACKUP_ENDPOINT=https://lon1.digitaloceanspaces.com
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
