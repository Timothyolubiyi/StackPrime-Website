# Copy this file to .env for local development, or populate it as the .env
# on each droplet via the deploy workflow. NEVER commit a real .env file.

# --- Public (baked into the client bundle at build time) ---
NEXT_PUBLIC_SITE_URL=https://stackprimeconsulting.com
NEXT_PUBLIC_ASSETS_CDN_URL=https://cdn.stackprimeconsulting.com
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=


# --- Server-side only ---
+# Contact form + newsletter provider: Zoho.
+# - Zoho CRM/Forms API: stores Contact Us submissions, triggers the
+#   notification email.
+# - Zoho Campaigns API: newsletter subscription target list.
+# OAuth-based (self-client), so client id/secret + a long-lived refresh
+# token are needed rather than a single static API key.
+ZOHO_CLIENT_ID=
+ZOHO_CLIENT_SECRET=
+ZOHO_REFRESH_TOKEN=
+ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
+ZOHO_CRM_API_DOMAIN=https://www.zohoapis.com
+ZOHO_CAMPAIGNS_LIST_KEY=
+ZOHO_NOTIFICATION_EMAIL=info@stackprimeconsulting.com
+
+# Spam protection on the Contact Us form (Google reCAPTCHA v3).
+# Site key is public — also add it as NEXT_PUBLIC_RECAPTCHA_SITE_KEY in the
+# "Public" block above so the client-side widget can use it.
+RECAPTCHA_SECRET_KEY=
 

# DigitalOcean Spaces (used server-side for any programmatic asset uploads,
# e.g. an admin-only Publications image upload flow, if/when built)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=stackprime-assets-production
DO_SPACES_REGION=nyc3

# Set automatically by the deploy workflow — which image tag this container
# is running, useful in logs/health output. Not required for local dev.
REGISTRY_IMAGE=
